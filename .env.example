# Copy to .env at the repository root. Do not commit .env.
# Choose a local password; URL-encode it in DATABASE_URL when necessary.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://newsdc:replace-with-local-password@127.0.0.1:55434/newsdc
PORT=5000
HOST=127.0.0.1
# Tests require a separate, empty disposable database. Never point at production.
# TEST_DATABASE_URL=postgresql://newsdc:password@127.0.0.1:55434/newsdc_test
# Browser-safe only; Vite reads apps/web/.env.local, not the root .env.
# VITE_API_BASE_URL=http://127.0.0.1:5000/api/v1

# Local operator dashboard secret; generate a long random value, never VITE_ prefixed.
ADMIN_API_KEY=replace-with-long-random-operator-key
INGESTION_ENABLED=false
INGESTION_INTERVAL_MS=1800000
