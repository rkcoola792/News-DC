    "schema:validate": "prisma validate"
  },
  "exports": "./src/index.js",
  "dependencies": {
    "@newsdc/shared": "0.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  }
}
