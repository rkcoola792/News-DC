generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["partialIndexes", "fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model categories {
  slug                 String                 @id
  name                 String
  content_category_map content_category_map[]
}

model content_category_map {
  content_id    String        @db.Uuid
  category_slug String
  categories    categories    @relation(fields: [category_slug], references: [slug], onDelete: NoAction, onUpdate: NoAction)
  content_items content_items @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([content_id, category_slug])
  @@index([category_slug, content_id], map: "category_content_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model content_items {
  id                                                                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_id                                                             String?                   @db.Uuid
  publisher_id                                                          String?                   @db.Uuid
  external_id                                                           String?
  content_type                                                          String
  title                                                                 String
  description                                                           String?
  url                                                                   String
  canonical_url                                                         String?                   @unique(map: "content_canonical_url_unique", where: raw("(canonical_url IS NOT NULL)"))
  author                                                                String?
  published_at                                                          DateTime?                 @db.Timestamptz(6)
  thumbnail_url                                                         String?
  duration_seconds                                                      Int?
  content_text                                                          String?
  ai_summary                                                            String?
  key_insights                                                          Json?
  intelligence_type                                                     String?
  is_data_center_relevant                                               Boolean?
  relevance_confidence                                                  Decimal?                  @db.Decimal
  relevance_score                                                       Decimal?                  @db.Decimal
  quality_score                                                         Decimal?                  @db.Decimal
  ai_status                                                             String                    @default("PENDING")
  ai_model                                                              String?
  prompt_version                                                        String?
  ai_processed_at                                                       DateTime?                 @db.Timestamptz(6)
  metadata                                                              Json                      @default("{}")
  content_fingerprint                                                   String?                   @unique(map: "content_fingerprint_unique", where: raw("(content_fingerprint IS NOT NULL)"))
  search_vector                                                         Unsupported("tsvector")?  @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, ((((COALESCE(description, ''::text) || ' '::text) || COALESCE(ai_summary, ''::text)) || ' '::text) || COALESCE(content_text, ''::text))), 'B'::\"char\"))"))
  created_at                                                            DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                                            DateTime                  @default(now()) @db.Timestamptz(6)
  content_category_map                                                  content_category_map[]
  publishers                                                            publishers?               @relation(fields: [publisher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sources                                                               sources?                  @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content_processing_logs                                               content_processing_logs[]
  content_relations_content_relations_content_idTocontent_items         content_relations[]       @relation("content_relations_content_idTocontent_items")
  content_relations_content_relations_related_content_idTocontent_items content_relations[]       @relation("content_relations_related_content_idTocontent_items")
  content_tag_map                                                       content_tag_map[]

  @@index([content_fingerprint], map: "content_fingerprint_idx", where: raw("(content_fingerprint IS NOT NULL)"))
  @@index([published_at(sort: Desc)], map: "content_published_idx")
  @@index([is_data_center_relevant, ai_status], map: "content_relevant_status_idx")
  @@index([search_vector], map: "content_search_idx", type: Gin)
  @@index([content_type, published_at(sort: Desc)], map: "content_type_published_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model content_processing_logs {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content_id     String        @db.Uuid
  status         String
  retry_count    Int           @default(0)
  model          String?
  prompt_version String?
  started_at     DateTime      @default(now()) @db.Timestamptz(6)
  ended_at       DateTime?     @db.Timestamptz(6)
  error_summary  String?
  content_items  content_items @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model content_relations {
  content_id                                                        String        @db.Uuid
  related_content_id                                                String        @db.Uuid
  score                                                             Decimal?      @db.Decimal
  reason                                                            String?
  content_items_content_relations_content_idTocontent_items         content_items @relation("content_relations_content_idTocontent_items", fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  content_items_content_relations_related_content_idTocontent_items content_items @relation("content_relations_related_content_idTocontent_items", fields: [related_content_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([content_id, related_content_id])
}

model content_tag_map {
  content_id    String        @db.Uuid
  tag_id        String        @db.Uuid
  content_items content_items @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags          tags          @relation(fields: [tag_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([content_id, tag_id])
  @@index([tag_id, content_id], map: "tag_content_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ingestion_runs {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_id      String    @db.Uuid
  status         String
  started_at     DateTime  @default(now()) @db.Timestamptz(6)
  ended_at       DateTime? @db.Timestamptz(6)
  fetched_count  Int       @default(0)
  inserted_count Int       @default(0)
  skipped_count  Int       @default(0)
  failed_count   Int       @default(0)
  error_summary  String?
  sources        sources   @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model publishers {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  domain        String?         @unique
  homepage_url  String?
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  content_items content_items[]
}

model schema_migrations {
  name       String   @id
  checksum   String
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sources {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  source_type     String
  endpoint_url    String
  is_enabled      Boolean          @default(true)
  config          Json             @default("{}")
  last_fetched_at DateTime?        @db.Timestamptz(6)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  content_items   content_items[]
  ingestion_runs  ingestion_runs[]
}

model tags {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @unique
  content_tag_map content_tag_map[]
}

model ai_provider_budget {
  id                String @id
  reserved_microusd Int    @default(0)
}

model ai_provider_daily {
  day      String @id
  requests Int    @default(0)
}

model ai_provider_calls {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          String
  model             String
  status            String    @default("RESERVED")
  reserved_microusd Int       @default(0)
  input_tokens      Int?
  output_tokens     Int?
  error_code        String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  ended_at          DateTime? @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "ai_provider_calls_created_idx")
}
